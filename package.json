{
  "name": "bol",
  "version": "0.1.0",
  "description": "Bol — speak anywhere, it types. System-wide AI dictation for Windows (Wispr Flow class): push-to-talk, AI cleanup, tones, dictionary, snippets, command mode, local/offline mode.",
  "main": "src/main/index.js",
  "author": "Danish",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node test/unit.js",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "io.timegram.bol",
    "productName": "Bol",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node",
      "src/main/helper/**",
      "node_modules/@huggingface/transformers/**",
      "node_modules/onnxruntime-node/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.2",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3"
  }
}
